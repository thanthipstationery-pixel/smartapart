{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartapart",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartapart-db",
      "database_id": "b45375ef-d42c-4175-8e75-dcc764c8e647"
    }
  ]
}
